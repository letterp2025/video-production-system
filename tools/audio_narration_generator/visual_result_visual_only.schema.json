{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VPS visual-only unit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "take_id", "segment_id", "request_id", "source_unit_sha256", "status", "implementation_path", "preview_path", "export_path", "provider", "updated_at", "completed_at", "error"],
  "properties": {
    "schema_version": { "const": 3 },
    "take_id": { "type": "string", "pattern": "^v_layer_[a-z0-9][a-z0-9_-]{0,48}$" },
    "segment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
    "request_id": { "type": "string", "pattern": "^VIS-[0-9]{3,6}$" },
    "source_unit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["requested", "in_progress", "completed", "failed"] },
    "implementation_path": { "type": ["string", "null"] },
    "preview_path": { "type": ["string", "null"] },
    "export_path": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"], "maxLength": 200 },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "error": { "type": ["string", "null"], "maxLength": 4000 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "export_path": { "type": "string", "minLength": 1 }, "completed_at": { "type": "string", "format": "date-time" }, "error": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "properties": { "completed_at": { "type": "null" }, "error": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "status": { "enum": ["requested", "in_progress"] } } }, "then": { "properties": { "completed_at": { "type": "null" }, "error": { "type": "null" } } } }
  ]
}
